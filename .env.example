# =============================================================================
# SUPABASE Configuration (Primary Database - Source of Truth)
# Get these from: https://app.supabase.com/project/_/settings/api
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# =============================================================================
# BREVO (Sendinblue) Configuration (Email Marketing & Secondary CRM)
# Get these from: https://app.brevo.com/settings/keys/api
# =============================================================================
VITE_BREVO_API_KEY=your_brevo_api_key_here
VITE_BREVO_LIST_ID=your_brevo_list_id_here

# =============================================================================
# WHATSAPP Configuration
# =============================================================================
# Your WhatsApp Business number (format: country code + number, no spaces or +)
VITE_WHATSAPP_PHONE_NUMBER=34600000000

# WhatsApp Business API (Twilio/360Dialog) - Optional for advanced integration
VITE_WHATSAPP_API_URL=your_whatsapp_api_url_here
VITE_WHATSAPP_API_TOKEN=your_whatsapp_api_token_here

# =============================================================================
# OPTIONAL: Backend API URL (if using custom backend for WhatsApp agent)
# =============================================================================
VITE_API_URL=http://localhost:3000
